# AROMA DAIAMOND｜AI自動電話受付システム 環境変数サンプル
# このファイルをコピーして .env を作成し、ホスティングの環境変数として設定してください。
# （.env はコミットしないこと。APIキーは一切ここには入りません＝橋渡し構成のため安全です）

# 必須：サイトのAIチャットと同じ Google Apps Script の /exec URL
# （リポジトリ内 data/chat-config.json の endpoint と同じ値）
CHAT_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec

# 待受ポート（Render/Railway/Fly などは自動で PORT を注入します。ローカルは 8080）
PORT=8080

# 読み上げ・音声認識の言語（日本語）
TTS_LANG=ja-JP
STT_LANG=ja-JP

# 任意：Twilio の音声名（例 Google.ja-JP-Neural2-B）。空なら Twilio 既定。
TTS_VOICE=

# 任意：最初の挨拶（未設定なら server.js の既定文言）
# GREETING=お電話ありがとうございます。アロマダイアモンドのAI受付です。ご用件をお話しください。

# 任意：トラブル時に案内する電話番号（音声内で読み上げる表示用）
SHOP_TEL=
